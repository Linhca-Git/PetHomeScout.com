    { "step": "runPHP", "code": "<?php require_once '/wordpress/wp-load.php';\n$pages = [\n['home','PetHomeScout','A cleaner, safer home for pets and family.'],\n['family-home','Family Home','Pet-friendly furniture, flooring, gates, and home-safety guidance.'],\n['smart-tech','Smart Tech','Research-led smart pet technology comparisons.'],\n['cleaning-odor','Cleaning & Odor','Pet hair, stains, odor, and air-quality guidance.'],\n['services-insurance','Services & Insurance','Pet insurance and local pet-care service decision paths.'],\n['pet-insurance','Pet Insurance','Factors to compare before requesting pet insurance quotes.'],\n['pet-insurance-for-french-bulldogs','Pet Insurance for French Bulldogs','Breed-specific factors to compare before requesting pet insurance quotes.'],\n['mobile-pet-grooming','Mobile Pet Grooming','What to compare when evaluating mobile grooming providers.'],\n['pet-sitting','Pet Sitting','What to compare when evaluating pet-sitting services.'],\n['pet-odor-cleaning','Pet Odor Carpet Cleaning','When DIY cleaning is enough and when professional help may help.'],\n['pet-tech-selector','Pet Tech Selector','A demo decision tool for pet technology.'],\n['methodology','Methodology','How PetHomeScout structures evidence and recommendations.'],\n['how-we-test','How We Test','Founder-test and research-led evidence rules.'],\n['affiliate-disclosure','Affiliate Disclosure','How commercial relationships are disclosed.'],\n['advertising-disclosure','Advertising Disclosure','Advertising and commercial relationship information.'],\n['privacy-policy','Privacy Policy','Privacy and data-use information.'],\n['terms','Terms','Terms of use for this review build.'],\n['do-not-sell-or-share','Do Not Sell or Share','Privacy request information.'],\n['contact','Contact','Contact PetHomeScout by department.']\n];\nforeach($pages as $page){ if(!get_page_by_path($page[0])){ wp_insert_post(['post_title'=>$page[1],'post_name'=>$page[0],'post_content'=>'<p>'.esc_html($page[2]).'</p>','post_status'=>'publish','post_type'=>'page']); } }\n$posts=[['best-robot-vacuum-for-dog-hair','Best Robot Vacuum for Dog Hair','Research-led fixture article for review-build validation.'],['how-to-remove-dog-urine-smell-from-carpet','How to Remove Dog Urine Smell from Carpet','Problem-first fixture article for contextual CTA validation.']];\nforeach($posts as $post){ if(!get_page_by_path($post[0],OBJECT,'post')){ wp_insert_post(['post_title'=>$post[1],'post_name'=>$post[0],'post_content'=>'<p>'.esc_html($post[2]).'</p>','post_status'=>'publish','post_type'=>'post']); } }\nflush_rewrite_rules(); update_option('blog_public',0); update_option('permalink_structure','/%postname%/');\n" }
